gn-items:center;padding:16px 0;flex-wrap:wrap;color:#777;font-size:12px}.sc-preview-controls button{font:inherit;border:1px solid #ddd;border-radius:7px;padding:8px 12px;background:#fff;cursor:pointer}.sc-preview-controls button[aria-pressed=true]{background:#eee;color:#222}.sc-preview-controls [role=group]{display:flex;gap:6px}.sc-preview-explorer table{width:100%;border-collapse:collapse;font-size:13px}.sc-preview-explorer th,.sc-preview-explorer td{border-bottom:1px solid #eee;padding:14px 16px;text-align:left}.sc-preview-explorer th{background:#fafafa;color:#777;font-size:12px}.sc-preview-explorer tbody tr{cursor:pointer}.sc-preview-explorer tbody tr:hover{background:#fafafa}.sc-preview-explorer tbody tr:focus-visible{outline:2px solid #666;outline-offset:-2px}.sc-preview-explorer table td:last-child{font-size:var(--sc-import-type-body);min-width:180px;overflow-wrap:anywhere;color:#999;line-height:var(--sc-import-leading-body);}.sc-preview-diffs article{padding:14px;border:1px solid #ddd;border-radius:8px;margin:8px 0}.sc-preview-diffs article>div{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;margin-top:8px;overflow-wrap:anywhere}.sc-preview-review-summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:20px 0}.sc-preview-review-summary>div{padding:18px;border:1px solid #ddd;border-radius:8px}.sc-preview-review-summary strong{display:block;font-size:24px}.sc-preview-review-summary span{color:#888;font-size:12px}\r\n"],["STYLE",{},".import-page__date { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; min-width: 0; }\r\n.import-page__date label { font-size: 14px; font-weight: 500; color: #565656; }\r\n.import-page__date input { width: 184px; max-width: 100%; min-height: 42px; border: 1px solid #d8d8d8; border-radius: 9px; padding: 8px 12px; background: #fff; color: #454545; font-size: 14px; color-scheme: light; }\r\n.import-page__main { max-width: 1320px; margin: 0 auto; padding: 24px 48px 32px; }\r\n.import-page__main h1 { margin: 0; font-size: 28px; line-height: 36px; font-weight: 600; letter-spacing: -.6px; }\r\n.import-page__heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }\r\n.import-page__heading > div { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }\r\n.import-page__step { padding: 2px 7px; border: 1px solid #e3e3e3; border-radius: 5px; background: #f7f7f7; color: #757575; font-size: 11px; line-height: 18px; }\r\n.import-page__help { flex: none; min-height: 38px; padding: 8px 16px; border: 1px solid #d6d6d6; border-radius: 8px; background: #fff; color: #626262; font-size: 13px !important; cursor: pointer; }\r\n.import-page__source { margin: 0 0 16px !important; color: #777; font-size: 12px; line-height: 20px; }\r\n.import-page__batch-details { margin-top: 24px; color: #737373; font-size: 13px; }\r\n.import-page__batch-details > summary { width: fit-content; padding-block: 10px; cursor: pointer; }\r\n.import-page__batch-details .import-batch { margin-top: 12px; }\r\n.import-page__upload-column { min-width: 0; display: flex; flex-direction: column; gap: 20px; }\r\n.import-page__feedback { grid-column: 1; min-width: 0; font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }\r\n.import-page__feedback p { margin: 0 0 12px; }\r\n.import-page__error { padding: 14px; border: 1px solid #999; border-radius: 8px; background: #f5f5f5; }\r\n.import-page :focus-visible { outline: 2px solid #555; outline-offset: 3px; }\r\n.import-page__grid { display: grid; grid-template-columns: minmax(0, 1fr) 184px; align-items: start; gap: 24px; }\r\n.import-page__utilities { display: flex; flex-direction: column; gap: 12px; min-width: 0; }\r\n.import-page__utilities > * { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 44px; padding: 10px 16px; border: 1px solid #575757; border-radius: 9px; background: #575757; color: #fff; font-size: 14px; line-height: 22px; font-weight: 500; text-decoration: none; }\r\n.import-page__utilities a:hover, .import-page__utilities button:not(:disabled):hover { background: #404040; border-color: #404040; }\r\n.import-page__utilities button:not(:disabled) { cursor: pointer; }\r\n.import-page__utilities button:disabled { background: #f3f3f3; color: #888; border-color: #ddd; cursor: not-allowed; }\r\n.import-page__process { grid-column: 1; display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 16px; }\r\n.import-page__process p { flex: 1; color: #777; font-size: 12px; line-height: 20px; }\r\n.import-page__process button { min-width: 208px; min-height: 50px; padding: 12px 24px; border: 1px solid #e3e3e3; border-radius: 10px; background: #e9e9e9; color: #777; font-size: 15px; font-weight: 600; cursor: not-allowed; }\r\n.import-page__process button:not(:disabled) { background: #555; border-color: #555; color: white; cursor: pointer; }\r\n@media (max-width: 1180px) {\r\n  .import-page__main { padding-inline: 28px; }\r\n  .import-page__grid { grid-template-columns: minmax(0, 1fr) 152px; gap: 20px; }\r\n}\r\n@media (max-width: 950px) {\r\n  .import-page__grid { grid-template-columns: minmax(0, 1fr); }\r\n  .import-page__utilities { grid-row: 2; flex-direction: row; }\r\n  .import-page__utilities > * { flex: 1; min-width: 0; padding-inline: 10px; }\r\n}\r\n@media (max-width: 680px) {\r\n  .import-page__main { padding: 28px 20px 40px; }\r\n  .import-page__main h1 { font-size: 26px; }\r\n  .import-page__date { gap: 8px; }\r\n  .import-page__date label { font-size: 12px; }\r\n  .import-page__date input { width: 130px; font-size: 12px; }\r\n  .import-page__process { align-items: stretch; flex-direction: column; }\r\n  .import-page__process button { width: 100%; min-width: 0; }\r\n}\r\n@media (max-width: 380px) {\r\n  .import-page__main { padding-inline: 12px; }\r\n  .import-page__utilities { flex-direction: column; }\r\n}\r\n\r\n.import-page__feedback button { min-height: 44px; padding: 10px 18px; border: 1px solid #555; border-radius: 9px; color: white; background: #555; font-size: 14px; cursor: pointer; }\r\n\r\n/* Canonical OWNER/STAFF Input flow. Scoped to Import; the app sidebar remains shared. */\r\n.import-page__heading { margin-bottom: 4px; }\r\n.input-subtitle { color: #777; font-size: 13px; margin: 6px 0 18px; }\r\n.input-view-tabs { display: flex; gap: 6px; flex-wrap: wrap; padding-bottom: 18px; border-bottom: 1px solid #ededed; }\r\n.input-view-tabs > * { padding: 9px 12px; border: 1px solid transparent; border-radius: 7px; background: white; color: #737373; font: inherit; font-size: 12px; text-decoration: none; cursor: pointer; }\r\n.input-view-tabs [aria-current] { background: #f1f1f1; color: #333; border-color: #dedede; font-weight: 600; }\r\n.input-steps { display: flex; align-items: stretch; padding: 16px 0 18px; margin: 0 0 20px; border-bottom: 1px solid #ededed; list-style: none; overflow-x: auto; }\r\n.input-steps li { position: relative; display: flex; flex: 1 1 0; min-width: 125px; height: 54px; align-items: center; justify-content: center; gap: 9px; margin-left: -15px; padding: 0 22px 0 30px; background: #fafafa; color: #888; font-size: 11px; clip-path: polygon(0 0,calc(100% - 15px) 0,100% 50%,calc(100% - 15px) 100%,0 100%,15px 50%); }\r\n.input-steps li:first-child { margin-left: 0; padding-left: 12px; clip-path: polygon(0 0,calc(100% - 15px) 0,100% 50%,calc(100% - 15px) 100%,0 100%); }\r\n.input-steps li > span { display: grid; place-items: center; width: 24px; height: 24px; flex: none; border: 1px solid #d2d2d2; border-radius: 50%; color: #777; background: white; font-size:var(--sc-import-type-micro); line-height:var(--sc-import-leading-micro);}\r\n.input-steps small { display: block; margin-top: 3px; font-size:var(--sc-import-type-micro); line-height:var(--sc-import-leading-micro);}\r\n.input-steps .current { background: #626262; color: white; }\r\n.input-steps .complete { color: #444; background: #f0f0f0; }\r\n.input-source { display: grid; grid-template-columns: 1.25fr .6fr 1.5fr 1fr; margin: 0 0 18px; border: 1px solid #dedede; border-radius: 10px; background: #fafafa; overflow: hidden; font-size: 12px; }\r\n.input-source > div { padding: 13px 15px; min-width: 0; border-right: 1px solid #e6e6e6; }\r\n.input-source dt { color: #888; font-size:var(--sc-import-type-label); margin-bottom: 5px; line-height:var(--sc-import-leading-label);}\r\n.input-source dd { margin: 0; color: #444; overflow-wrap: anywhere; }\r\n.input-section-title { margin-bottom: 18px; }\r\n.input-section-title small { color: #999; font-size:var(--sc-import-type-label); text-transform: uppercase; letter-spacing: .6px; line-height:var(--sc-import-leading-label);}\r\n.input-section-title h2 { margin: 4px 0 !important; font-size: 24px !important; line-height: 32px; font-weight: 600; }\r\n.input-section-title p { color: #777; font-size: 13px; margin: 5px 0; }\r\n.input-status { padding: 14px 16px; border: 1px solid #d8d8d8; border-radius: 10px; margin: 14px 0; background: #fafafa; font-size: 12px; line-height: 1.65; overflow-wrap: anywhere; }\r\n.input-status p { margin: 5px 0; }\r\n.input-status button { margin: 8px 8px 0 0; }\r\n.input-actions { display: flex; justify-content: flex-end; align-items: center; flex-wrap: wrap; gap: 10px; margin-top: 22px; padding-top: 18px; border-top: 1px solid #ededed; }\r\n.input-actions > p, .input-actions > span { margin-right: auto; color: #888; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.import-page .input-primary { background: #565656; border: 1px solid #565656; border-radius: 8px; color: white; padding: 10px 18px; min-height: 40px; font: inherit; font-size: 12px; cursor: pointer; }\r\n.import-page button:disabled { opacity: .5; cursor: not-allowed; }\r\n.input-resolve-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 18px 0; }\r\n.input-resolve-grid > section { padding: 15px; border: 1px solid #ddd; border-radius: 10px; background: white; }\r\n.input-resolve-grid h3 { display: inline; font-size: 13px; }\r\n.input-resolve-grid > section > span { display: inline-grid; place-items: center; width: 28px; height: 28px; border: 1px solid #d9d9d9; border-radius: 7px; background: #f5f5f5; margin-right: 9px; font-size:var(--sc-import-type-label); line-height:var(--sc-import-leading-label);}\r\n.input-resolve-grid p { color: #888; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.input-readout { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 20px 0; border: 1px solid #ddd; border-radius: 10px; }\r\n.input-readout > div { padding: 18px; }\r\n.input-readout span, .input-readout strong { display: block; }\r\n.input-readout span { color: #888; font-size:var(--sc-import-type-label); line-height:var(--sc-import-leading-label);}\r\n.input-readout strong { margin-top: 8px; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.input-analysis-status { padding: 30px; border: 1px solid #ddd; border-radius: 12px; display: flex; align-items: center; gap: 20px; background: #fafafa; }\r\n.input-analysis-status > span { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid #ccc; border-radius: 50%; }\r\n.input-analysis-status p { color: #777; font-size: 12px; }\r\n.input-readiness { padding: 22px; border: 1px solid #ddd; border-radius: 12px; margin-top: 24px; }\r\n.input-readiness > header { display: flex; justify-content: space-between; align-items: start; gap: 12px; }\r\n.input-readiness h2 { margin: 4px 0; font-size: 20px; }\r\n.input-readiness p, .input-readiness small { color: #777; font-size: 12px; }\r\n.input-readiness label { display: block; margin: 16px 0; font-size: 12px; }\r\n.input-readiness input { display: block; margin-top: 6px; padding: 10px; border: 1px solid #ddd; border-radius: 7px; font: inherit; }\r\n.import-page__grid { grid-template-columns: minmax(0, 1fr); }\r\n.import-page__grid > .import-page__utilities { display: none; }\r\n.import-page .import-upload__files { height: auto; min-height: 140px; }\r\n.import-page .import-upload__file-list { max-height: 320px; }\r\n.import-page .import-flow__card { border-radius: 10px; }\r\n@media (max-width: 680px) {\r\n  .input-source, .input-resolve-grid, .input-readout { grid-template-columns: repeat(2, minmax(0, 1fr)); }\r\n  .input-source > div { padding: 10px; }\r\n  .input-actions { align-items: stretch; }\r\n  .input-readiness { padding: 16px; }\r\n  .input-resolve-grid { grid-template-columns: minmax(0, 1fr); }\r\n}\r\n\r\n.input-steps li > div { min-width: 0; }\r\n.input-steps strong, .input-steps small { white-space: nowrap; }\r\n/* The 10px secondary line needs 81px; reserve 83px inside the chevron. */\r\n@media (max-width: 680px) { .input-steps li { flex: 0 0 168px; } }\r\n\r\n.input-pair { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-bottom: 1px solid #eee; font-size: 12px; }\r\n.input-resolution-summary { display: flex; justify-content: space-between; gap: 12px; padding: 16px 0; font-size: 12px; color: #777; }\r\n.input-batch-only { margin-top: 18px; padding: 18px; border: 1px solid #ddd; background: #fafafa; border-radius: 10px; }\r\n.input-batch-only h3 { margin: 0; font-size: 13px; }\r\n.input-batch-only p { color: #888; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.input-business-row { padding: 8px 0; }\r\n.import-page .sc-preview-explorer { margin-top: 0; }\r\n.import-page .input-profile-grid { margin-top: 0; }\r\n\r\n.input-analysis-readout { grid-template-columns: repeat(3, minmax(0, 1fr)); }\r\n.input-analysis-readout strong { font-size: 16px; overflow-wrap: anywhere; }\r\n@media (max-width: 680px) { .input-analysis-readout { grid-template-columns: minmax(0, 1fr); } }\r\n\r\n.input-section-title--stat { display: flex; justify-content: space-between; align-items: start; gap: 20px; }\r\n.input-stat { display: flex; align-items: center; gap: 7px; border: 1px solid #ddd; border-radius: 10px; padding: 12px; white-space: nowrap; font-size:var(--sc-import-type-label); color: #888; background: #fafafa; line-height:var(--sc-import-leading-label);}\r\n.input-stat strong { color: #333; font-size: 20px; }\r\n@media (max-width: 680px) { .input-section-title--stat { gap: 10px; flex-wrap: wrap; } }\r\n\r\n.input-progress-list { display: grid; gap: 10px; margin: 20px 0; }\r\n.input-progress-list > div { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid var(--border, #e8e8e8); border-radius: 10px; }\r\n.input-progress-list > div > span { color: #16a36b; }\r\n.input-progress-list strong { flex: 1; font-size: 14px; }\r\n.input-progress-list small { color: #777; }\r\n\r\n.input-profile-badge { float: right; margin-left: 12px; }\r\n\r\n/* 015 parity pass: latest MagicPath geometry; data remain canonical, never demo counts. */\r\n.import-page__main { max-width:none; padding:24px 48px 40px; }\r\n.input-subtitle { margin:5px 0 16px; font-size:12px; color:#858585; }\r\n.input-source { grid-template-columns:1.25fr 1fr 1fr 1.2fr; }\r\n.input-source > div { padding:10px 14px; }\r\n.input-source > div:last-child { border-right:0; }\r\n.input-source dt { font-size:var(--sc-import-type-label); margin-bottom:2px; line-height:var(--sc-import-leading-label);}\r\n.input-source dd { font-size:var(--sc-import-type-body); font-weight:600; line-height:var(--sc-import-leading-body);}\r\n.input-stat { align-items:baseline; padding:8px 11px; border-radius:8px; }\r\n.input-stat strong { font-size:17px; }\r\n.input-section-title { margin-bottom:16px; }\r\n.input-readout { margin:14px 0; overflow:hidden; }\r\n.input-readout > div { padding:11px 13px; border-right:1px solid #eee; }\r\n.input-readout span { font-size:var(--sc-import-type-label); line-height:var(--sc-import-leading-label);}\r\n.input-readout strong { margin-top:2px; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.sc-preview-explorer .input-readout strong { font-size:20px; }\r\n.input-progress-list { gap:0; margin:0 0 14px; border:1px solid #ddd; border-radius:10px; overflow:hidden; }\r\n.input-progress-list > div { padding:13px 15px; gap:10px; border:0; border-bottom:1px solid #eee; border-radius:0; }\r\n.input-progress-list > div:last-child { border:0; }\r\n.input-progress-list > div > span { color:#666; width:26px; }\r\n.input-progress-list strong { font-size:12px; }\r\n.input-progress-list small { font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.input-status-card { display:grid; grid-template-columns:38px minmax(0,1fr); gap:13px; align-items:center; margin:0 0 14px; padding:16px; border:1px solid #d9d9d9; border-radius:10px; background:#fafafa; }\r\n.input-status-card > span { display:flex; align-items:center; justify-content:center; width:34px; height:34px; border:1px solid #c4c4c4; border-radius:50%; background:#eee; }\r\n.input-status-card strong { font-size:13px; }\r\n.input-status-card p { margin:3px 0 0; color:#7f7f7f; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.input-status-card.warn { border-style:dashed; }\r\n.input-status-card.error { border-color:#c9c9c9; background:#f3f3f3; }\r\n.import-page .import-upload__dropzone { min-height:210px; padding:24px; border-radius:12px; gap:8px; }\r\n.import-page .import-upload__title { font-size:22px; font-weight:500; }\r\n.import-page .import-upload__hint { font-size:12px; }\r\n.import-page .import-upload__files { min-height:125px; }\r\n.import-page .import-upload__files-heading { padding:10px 14px; }\r\n.import-page .import-upload__files-heading h2 { font-size:12px; }\r\n.import-page .import-upload__file-list li { padding:10px 14px; gap:10px; }\r\n.import-page .import-upload__file-icon { width:24px; height:28px; font-size:18px; border:0; background:transparent; }\r\n.import-page .import-upload__filename { font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.import-page .import-upload__file-size { font-size:var(--sc-import-type-micro); margin-top:1px!important; line-height:var(--sc-import-leading-micro);}\r\n.import-page .import-upload__empty { padding:42px; font-size:12px; }\r\n.import-page__process { border-top:1px solid #e2e2e2; padding-top:12px; }\r\n.import-page__process button { min-height:38px; min-width:0; padding:8px 13px; font-size:12px; border-radius:8px; }\r\n.import-page__process button:not(:disabled) { background:#2c2c2c; border-color:#2c2c2c; }\r\n.import-page .sc-preview-explorer table { font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.import-page .sc-preview-explorer th,.import-page .sc-preview-explorer td { padding:10px 12px; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.import-page .sc-preview-explorer td:last-child { min-width:0; }\r\n.import-page .sc-preview-explorer td:last-child button { border:0; padding:0; min-height:28px; background:transparent; color:#666; font-size:var(--sc-import-type-control); text-decoration:underline; line-height:var(--sc-import-leading-control);}\r\n.import-page .sc-flow-tabs { margin:14px 0; }\r\n.import-page .sc-flow-tabs button { font-size:var(--sc-import-type-control); padding:9px 12px; line-height:var(--sc-import-leading-control);}\r\n.import-page .sc-preview-review-summary { gap:0; border:1px solid #ddd; border-radius:10px; overflow:hidden; margin:14px 0; }\r\n.import-page .sc-preview-review-summary > div { padding:12px 14px; border:0; border-right:1px solid #eee; border-radius:0; }\r\n.import-page .sc-preview-review-summary span { font-size:var(--sc-import-type-label); line-height:var(--sc-import-leading-label);}\r\n.import-page .sc-preview-review-summary strong { font-size:20px; }\r\n.import-page .sc-preview-review-summary small { color:#888; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.import-page [aria-label='Owner duyệt mapping profile'] > .import-flow__card { border:0; padding:0; }\r\n.input-profile-grid > section > span { display:none!important; }\r\n.input-profile-grid > section { padding:14px; }\r\n.input-profile-grid h3 { font-size:13px; }\r\n@media(max-width:850px) { .import-page__main { padding-left:24px; padding-right:24px; } .input-source { grid-template-columns:1fr 1fr; } }\r\n.import-evidence { width:min(420px,100vw); }\r\n.import-evidence .sc-flow-dialog-header,.import-evidence .sc-flow-dialog-body { padding:18px; }\r\n.import-evidence .sc-flow-dialog-header small { display:block; color:#888; font-size:var(--sc-import-type-label); line-height:var(--sc-import-leading-label);}\r\n.import-evidence .sc-flow-dialog-header h2 { font-size:20px; line-height:28px; }\r\n.import-evidence .sc-flow-section h3 { font-size:var(--sc-import-type-card); line-height:var(--sc-import-leading-card);}\r\n.import-evidence .sc-flow-section { padding:11px 0; margin:0; }\r\n.import-evidence .sc-flow-dialog-body { font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.import-result__summary h3 { display:flex; align-items:center; gap:10px; margin:0; font-size:18px; }\r\n.input-processing { display:flex; min-height:420px; flex-direction:column; align-items:center; justify-content:center; text-align:center; }\r\n.input-processing h2 { margin:18px 0 8px; font-size:24px; }\r\n.input-processing > p { max-width:520px; color:#888; font-size:12px; }\r\n.input-processing-indicator,.input-processing-icon { width:34px; height:34px; border:1px solid #c4c4c4; border-radius:50%; }\r\n.input-processing-indicator { border-style:dashed; border-top-color:#555; }\r\n.input-processing-icon { display:grid; place-items:center; background:#eee; }\r\n.input-processing-list { display:grid; gap:8px; width:340px; max-width:100%; margin-top:22px; padding:16px; border:1px solid #ddd; border-radius:10px; text-align:left; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.input-processing-list span { color:#888; }\r\n.input-processing-actions { display:flex; gap:8px; margin-top:18px; }\r\n"],["STYLE",{},".sc-inventory-vi .sc-vi-card{background:#fff}.sc-inventory-vi .sc-vi-legend{display:grid;grid-template-columns:1fr 1fr}.sc-inventory-vi .sc-vi-legend li{align-items:center}.sc-inventory-expiry{display:grid;grid-template-columns:auto minmax(45px,1fr) auto;align-items:center;gap:10px;margin-top:16px;font-size:11px;line-height:18px}.sc-inventory-expiry>div{height:4px;background:#ddd;position:relative}.sc-inventory-expiry i{position:absolute;top:-4px;width:2px;height:12px;background:#444}.sc-inventory-deltas{overflow:auto;max-width:100%;margin-top:10px}.sc-inventory-deltas-track{display:flex;gap:12px;min-width:max-content}.sc-inventory-delta{min-width:72px;display:flex;flex-direction:column;align-items:center;font-size:11px;line-height:18px}.sc-inventory-delta strong{font-size:12px;font-weight:500}.sc-inventory-delta-bar{position:relative;width:100%;height:56px;}.sc-inventory-delta-bar i{position:absolute;bottom:28px;left:calc(50% - 4px);width:8px;border-radius:2px;background:#555}.sc-inventory-delta-bar i[data-negative=true]{top:28px;bottom:auto;background:#888}@media(max-width:480px){.sc-inventory-vi .sc-vi-legend{grid-template-columns:1fr}}\n .sc-inventory-delta-bar:before{content:\"\";position:absolute;top:27px;left:0;right:0;height:1px;background:#ddd}\r\n"],["STYLE",{},".inventory-page { font-size: 14px; line-height: 1.5; }\r\n.inventory-page button { cursor: pointer; }\r\n.inventory-page button:disabled { cursor: not-allowed; color: #999; }\r\n.inventory-location { color: #777; font-size: 14px; }\r\n.inventory-workspace { display: flex; align-items: flex-start; position: relative; min-width: 0; width: 100%; container: inventory-workspace / inline-size; }\r\n.inventory-content { flex: 1; min-width: 0; padding: 24px 48px