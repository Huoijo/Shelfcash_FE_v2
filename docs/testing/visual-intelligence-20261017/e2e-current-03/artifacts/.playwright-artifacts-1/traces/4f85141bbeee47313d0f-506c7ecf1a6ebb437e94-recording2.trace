portant; }\r\n\r\n/* Positive CTA allowlist, never a global .primary override. */\r\n:is(\r\n  .sc-page .sc-button.sc-primary,\r\n  .auth-form__primary-button,\r\n  .sc-today-primary-action,\r\n  .menu-primary,\r\n  .sc-planning-content:not(.sc-planning-lifecycle) .sc-planning-primary-cta,\r\n  .import-page .input-primary:not([data-brand-accent='false']),\r\n  .import-flow .import-flow__primary:not([data-brand-accent='false']),\r\n  .sc-store-members-heading > .sc-store-primary,\r\n  .sc-store-tabpanel form.sc-store-stack > .sc-store-actions > .sc-store-primary,\r\n  .store-bootstrap__card .sc-store-primary,\r\n  .sc-invite-form .sc-invite-primary,\r\n  .notification-dialog a.sc-flow-primary,\r\n  [data-brand-accent='true']\r\n):not(:disabled):not([aria-disabled='true']):not([data-brand-accent='false']) {\r\n  background: var(--sc-brand-green) !important;\r\n  border-color: var(--sc-brand-green) !important;\r\n  color: #fff !important;\r\n}\r\n:is(\r\n  .sc-page .sc-button.sc-primary,\r\n  .auth-form__primary-button,\r\n  .sc-today-primary-action,\r\n  .menu-primary,\r\n  .sc-planning-content:not(.sc-planning-lifecycle) .sc-planning-primary-cta,\r\n  .import-page .input-primary:not([data-brand-accent='false']),\r\n  .import-flow .import-flow__primary:not([data-brand-accent='false']),\r\n  .sc-store-members-heading > .sc-store-primary,\r\n  .sc-store-tabpanel form.sc-store-stack > .sc-store-actions > .sc-store-primary,\r\n  .store-bootstrap__card .sc-store-primary,\r\n  .sc-invite-form .sc-invite-primary,\r\n  .notification-dialog a.sc-flow-primary,\r\n  [data-brand-accent='true']\r\n):not(:disabled):not([aria-disabled='true']):not([data-brand-accent='false']):hover {\r\n  background: var(--sc-brand-green-hover) !important;\r\n  border-color: var(--sc-brand-green-hover) !important;\r\n}\r\n\r\n/* Focus and selected controls; no blanket green body links or icons. */\r\n:is(.sc-page, .login-page, .app-shell, .sc-invite-page, .sc-flow-dialog, .sc-store-drawer) :focus-visible {\r\n  outline-color: var(--sc-brand-green) !important;\r\n}\r\n:is(.auth-form__input-shell, .sc-invite-input-shell, .menu-search, .inventory-search,\r\n  .history-search-control, .sc-planning-date-control, .sc-planning-currency-control,\r\n  .sc-proc-input-with-unit):focus-within {\r\n  outline-color: var(--sc-brand-green) !important;\r\n  border-color: var(--sc-brand-green-border) !important;\r\n}\r\n.sc-store-input:focus:not([aria-invalid='true']),\r\n.sc-invite-field input:focus:not([aria-invalid='true']) {\r\n  outline-color: var(--sc-brand-green) !important;\r\n  border-color: var(--sc-brand-green-border) !important;\r\n}\r\ninput[type='checkbox'], input[type='radio'] {\r\n  accent-color: var(--sc-brand-green);\r\n}\r\n.auth-form__tabs button[aria-selected='true'],\r\n.sc-store-tabs button[aria-selected='true'],\r\n.sc-proc-tabs > button.sc-proc-tab-active,\r\n.inventory-detail-tabs button[aria-selected='true'] {\r\n  color: var(--sc-brand-green) !important;\r\n  border-color: var(--sc-brand-green) !important;\r\n}\r\n:is(\r\n  .input-view-tabs [aria-current],\r\n  .input-resolver-scope-tools button[aria-pressed='true'],\r\n  .sc-flow-tabs button[aria-selected='true'],\r\n  .menu-filters button[aria-pressed='true'],\r\n  .inventory-filters button[aria-pressed='true'],\r\n  .notification-page__filters button[aria-pressed='true'],\r\n  .sc-proc-ingredient-filters button.sc-proc-filter-active,\r\n  .sc-planning-priority-selected,\r\n  .history-calendar__day--active,\r\n  .history-calendar__day[aria-current],\r\n  .sc-today-day.sc-today-day-selected\r\n) {\r\n  color: var(--sc-brand-green) !important;\r\n  background: var(--sc-brand-green-soft) !important;\r\n  border-color: var(--sc-brand-green-border) !important;\r\n}\r\n.history-calendar__day[aria-current] .history-calendar__number,\r\n.sc-today-day-selected .sc-today-day-date,\r\n.sc-step-number {\r\n  color: var(--sc-brand-green) !important;\r\n}\r\n.sc-ingredient-popover [role='option'][aria-selected='