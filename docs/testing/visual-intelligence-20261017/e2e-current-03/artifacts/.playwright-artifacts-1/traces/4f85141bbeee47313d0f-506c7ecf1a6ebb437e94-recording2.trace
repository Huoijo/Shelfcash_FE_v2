nel { min-width: 0; overflow: hidden; border: 1px solid #dedede; border-radius: 11px; background: #fff; }\r\n.inventory-table-scroll { max-height: 640px; overflow: auto; scrollbar-width: thin; scrollbar-color: #bbb #fafafa; }\r\n.inventory-table-scroll:focus-visible { outline-offset: -3px; }\r\n.inventory-table-panel table { width: 100%; min-width: 650px; border-collapse: collapse; text-align: left; color: #6c6c6c; font-size: 14px; line-height: 22px; }\r\n.inventory-col-name { width: 28%; }.inventory-col-quantity { width: 21%; }.inventory-col-lots { width: 12%; }.inventory-col-expiry { width: 21%; }.inventory-col-status { width: 18%; }\r\n.inventory-table-panel thead { position: sticky; top: 0; z-index: 1; background: #f7f7f7; color: #777; }\r\n.inventory-table-panel thead th { padding: 12px 18px; font-size: 13px; font-weight: 500; white-space: nowrap; }\r\n.inventory-table-panel tbody th, .inventory-table-panel tbody td { height: 51px; padding: 11px 18px; border-top: 1px solid #eee; white-space: nowrap; }\r\n.inventory-table-panel tbody th { font-weight: 500; }\r\n.inventory-table-panel tbody th button { padding: 0; border: 0; border-radius: 3px; background: transparent; color: #555; font-weight: 500; text-align: left; }\r\n.inventory-table-panel tbody tr { cursor: pointer; }\r\n.inventory-table-panel tbody tr:hover { background: #fafafa; }\r\n.inventory-table-panel tbody tr.inventory-row-selected { background: #f0f0f0; }\r\n.inventory-row-selected th button { color: #333; font-weight: 600; }\r\n.inventory-current-quantity { color: #515151; font-variant-numeric: tabular-nums; }\r\n.inventory-row-note { display: block; font-size: 10px; line-height: 17px; color: #777; }\r\n.inventory-status { display: inline-flex; align-items: center; min-height: 23px; padding: 2px 6px; border: 1px solid #e5e5e5; border-radius: 5px; background: #fafafa; color: #777; font-size: 11px; line-height: 17px; white-space: nowrap; }\r\n.inventory-status--near_expiry, .inventory-status--low_st