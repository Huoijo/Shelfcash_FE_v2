rand-success='true'] {\r\n  color: var(--sc-success-green) !important;\r\n}\r\n.notification-bell__count {\r\n  background: var(--sc-brand-green) !important;\r\n}\r\n.notification-row--unread .notification-row__content strong > span,\r\n.history-calendar__count > span[aria-hidden='true'] {\r\n  color: var(--sc-brand-green) !important;\r\n}\r\n.notification-page__heading h1 small {\r\n  color: var(--sc-brand-green) !important;\r\n  border-color: var(--sc-brand-green-border) !important;\r\n  background: var(--sc-brand-green-soft) !important;\r\n}\r\n\r\n/* Negative/uncertain confirmations remain neutral, including their controls. */\r\n.sc-flow-dialog:has(.sc-flow-primary:not([data-brand-accent='true'])) input[type='checkbox'],\r\n.sc-flow-dialog:has(.sc-flow-primary:not([data-brand-accent='true'])) input[type='radio'],\r\n.sc-store-drawer:has([data-brand-accent='false']) input[type='checkbox'],\r\n.sc-store-drawer:has([data-brand-accent='false']) input[type='radio'] {\r\n  accent-color: #555;\r\n}\r\n.sc-flow-dialog:has(.sc-flow-primary:not([data-brand-accent='true'])) :focus-visible,\r\n.sc-store-drawer:has([data-brand-accent='false']) :focus-visible,\r\n.import-resolver:has(option[value='IGNORE']:checked) :focus-visible {\r\n  outline-color: #616161 !important;\r\n}\r\n.import-resolver:has(option[value='IGNORE']:checked) input[type='checkbox'] {\r\n  accent-color: #555;\r\n}\r\n.import-resolver:has(option[value='IGNORE']:checked) [data-brand-accent='true']:not(:disabled) {\r\n  background: #2C2C2C !important;\r\n  border-color: #2C2C2C !important;\r\n  color: #fff !important;\r\n}\r\n*,\r\n*::before,\r\n*::after {\r\n  box-sizing: border-box;\r\n}\r\n\r\nhtml {\r\n  min-width: 320px;\r\n  min-height: 100%;\r\n}\r\n\r\nbody {\r\n  margin: 0;\r\n  min-width: 320px;\r\n  min-height: 100vh;\r\n  font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n}\r\n\r\n#root {\r\n  min-height: 100vh;\r\n}\r\n\r\n.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }\r\n"],["STYLE",{},".development-trigger { position: fixed; bottom: 12px; right: 12px; z-index: 1000; min-height: 32px; padding: 6px 12px; border: 1px solid #ccc; border-radius: 8px; background: #fff; color: #555; font: 12px system-ui; cursor: pointer; box-shadow: 0 2px 10px #0001; }\r\n.development-drawer { z-index: 1002; position: fixed; inset: 12px 12px 12px auto; width: min(560px, calc(100vw - 24px)); max-width: none; height: calc(100dvh - 24px); max-height: none; margin: 0; padding: 0; border: 1px solid #ccc; border-radius: 12px; background: #fff; color: #333; font: 13px/1.6 system-ui; }\r\n.development-backdrop { position: fixed; inset: 0; z-index: 1001; background: #0002; }\r\n.development-drawer > header { display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; border-bottom: 1px solid #ddd; }\r\n.development-drawer h2 { margin: 0; font-size: 18px; }\r\n.development-drawer button { cursor: pointer; padding: 6px 10px; border: 1px solid #ddd; border-radius: 6px; background: #fff; color: #333; }\r\n.development-body { padding: 18px; overflow: auto; height: calc(100% - 58px); }\r\n.development-section { margin-top: 16px; padding-top: 12px; border-top: 1px solid #eee; }\r\n.development-section pre { white-space: pre-wrap; overflow-wrap: anywhere; font-size: 11px; }\r\n.development-section summary { cursor: pointer; }\r\n.development-section select { max-width: 100%; padding: 6px; }\r\n.development-section fieldset { margin: 0; border: 1px solid #ddd; border-radius: 8px; }\r\n.development-section button { margin: 4px; }\r\n\r\n/* Keep the fixed trigger clear of product dialog footer actions. */\r\n.development-trigger-modal { bottom: 88px; }\r\n\r\n.development-drawer { width: min(370px, calc(100vw - 24px)); }\r\n.development-drawer > he