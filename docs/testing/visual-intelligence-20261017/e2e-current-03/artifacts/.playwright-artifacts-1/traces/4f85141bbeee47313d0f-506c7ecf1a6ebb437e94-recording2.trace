n.menu-recipe-scroll { overflow: auto; border: 1px solid #e1e1e1; border-radius: 8px; }\r\n.menu-recipe table { width: 100%; min-width: 360px; table-layout: fixed; border-collapse: collapse; text-align: left; font-size: 13px; line-height: 22px; color: #727272; }\r\n.menu-recipe-col-name { width: 50%; }.menu-recipe-col-quantity { width: 30%; }.menu-recipe-col-unit { width: 20%; }\r\n.menu-recipe thead { background: #f7f7f7; color: #777; }\r\n.menu-recipe thead th { padding: 9px 10px; font-weight: 400; font-size: 11px; white-space: nowrap; }\r\n.menu-recipe tbody th, .menu-recipe tbody td { padding: 10px; border-top: 1px solid #ededed; overflow-wrap: anywhere; vertical-align: top; }\r\n.menu-recipe tbody th { color: #636363; font-weight: 500; }\r\n.menu-recipe tbody td:nth-child(2) { color: #535353; font-variant-numeric: tabular-nums; }\r\n.menu-recipe tbody td:last-child { color: #777; }\r\n.menu-recipe-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 16px; color: #777; font-size: 11px; line-height: 18px; overflow-wrap: anywhere; }\r\n.menu-recipe-empty { padding: 34px 8px; text-align: center; color: #777; font-size: 13px; line-height: 22px; }\r\n.menu-detail-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; flex: none; padding: 14px 20px; border-top: 1px solid #e7e7e7; background: #fff; }\r\n.menu-text-action { padding: 0; border: 0; border-radius: 3px; background: transparent; color: #777; font-size: 12px; line-height: 22px; text-align: left; text-decoration: underline; text-underline-offset: 4px; }\r\n.menu-text-action:disabled { text-decoration: none; }\r\n.menu-ai-entry { min-height: 34px; padding: 5px 10px; border: 1px solid #d5d5d5; border-radius: 7px; background: #fff; color: #6a6a6a; font-size: 12px; line-height: 22px; }\r\n.menu-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }\r\n@container menu-workspace (min-width: 1120px) {\r\n  .menu-detail { position: sticky; top: 0; right: auto; bottom: auto; max-width: none; box-shadow: none; }\r\n  .menu-workspace[data-panel-open=true] > .menu-content { padding-inline: 28px; }\r\n  .menu-workspace[data-panel-open=true] .menu-search { width: 200px; }\r\n  .menu-workspace[data-panel-open=true] .menu-table-panel th, .menu-workspace[data-panel-open=true] .menu-table-panel td { padding-inline: 12px; }\r\n}\r\n@media (max-width: 1200px) { .menu-content { padding-inline: 32px; } }\r\n@media (max-width: 1000px) { .menu-content { padding-inline: 24px; }.menu-summary { gap: 14px; }.menu-search { width: 210px; } }\r\n@media (max-width: 680px) { .menu-detail { top: 76px; height: calc(100dvh - 76px); } }\r\n@media (max-width: 600px) {\r\n  .menu-content { padding: 24px 16px 28px; }\r\n  .menu-heading h1 { font-size: 24px; line-height: 32px; }\r\n  .menu-summary { gap: 10px; padding: 12px; font-size: 12px; }.menu-summary i { display: none; }\r\n  .menu-search { width: 100%; }.menu-detail { width: 400px; }\r\n  .menu-detail-header, .menu-detail-scroll { padding: 16px; }\r\n  .menu-product-facts { padding: 16px; gap: 8px; }.menu-product-facts dd { font-size: 15px; }\r\n}\r\n"],["STYLE",{},".sc-page { width:100%; background:#ffffff; color:#171717; font-family:inherit; font-size:16px; line-height:1.5; text-align:left; }\r\n.sc-page *, .sc-page *::before, .sc-page *::after { box-sizing:border-box; }\r\n.sc-page a { color:inherit; text-decoration:none; }\r\n.sc-page h1,.sc-page h2,.sc-page h3,.sc-page p { margin:0; }\r\n.sc-page button { font:inherit; cursor:pointer; }\r\n.sc-page :focus-visible { outline:2px solid #525252; outline-offset:4px; }\r\n.sc-container { width:calc(100% - 160px); max-width:1280px; margin-inline:auto; }\r\n.sc-navbar { height:80px; border-bottom:1px solid #e5e5e5; position:relative; background:#ffffff; z-index:2; }\r\n.sc-navbar-inner { display:grid; grid-template-columns:1fr auto 1fr; height:100%; align-items:center; gap:32px; }\r\n.sc-wordmark { justify-self:start; font-size:26px; font-weight:700; letter-spacing:-.7px; line-height:1.2; }\r\n.sc-desktop-nav { display:flex; align-items:center; justify-content:center; gap:32px; }\r\n.sc-navigation-item { display:inline-block; color:#525252 !important; font-size:15px; font-weight:500; line-height:24px; white-space:nowrap; }\r\n.sc-navigation-item:hover { color:#171717 !important; text-decoration:underline; text-underline-offset:5px; }\r\n.sc-navbar-actions { display:flex; justify-self:end; align-items:center; gap:12px; }\r\n.sc-button { min-height:52px; padding:13px 24px; display:inline-flex; align-items:center; justify-content:center; border-radius:6px; font-size:16px; line-height:24px; font-weight:600; white-space:nowrap; border:1px solid transparent; }\r\n.sc-primary { color:#ffffff !important; background:#262626; border-color:#262626; }\r\n.sc-primary:hover { background:#404040; border-color:#404040; }\r\n.sc-secondary { background:#ffffff; color:#262626 !important; border-color:#d4d4d4; }\r\n.sc-secondary:hover { background:#f5f5f5; border-color:#a3a3a3; }\r\n.sc-compact { min-height:42px; padding:8px 18px; font-size:15px; }\r\n.sc-menu-toggle { display:none; background:#ffffff; border:1px solid #d4d4d4; border-radius:6px; padding:8px 12px; }\r\n.sc-mobile-nav { display:none; }\r\n.sc-hero { padding-top:80px; text-align:center; }\r\n.sc-hero h1 { max-width:1080px; margin-inline:auto; font-size:60px; line-height:1.16; letter-spacing:-2.2px; font-weight:700; }\r\n.sc-hero-description { max-width:780px; margin:24px auto 0 !important; font-size:18px; line-height:30px; color:#626262; }\r\n.sc-actions { display:flex; align-items:center; justify-content:center; gap:12px; flex-wrap:wrap; margin-top:32px; }\r\n.sc-product-preview { height:480px; margin-top:56px; background:#f1f1f1; border:1px solid #d4d4d4; border-radius:10px; display:flex; align-items:center; justify-content:center; color:#858585; font-size:16px; letter-spacing:.