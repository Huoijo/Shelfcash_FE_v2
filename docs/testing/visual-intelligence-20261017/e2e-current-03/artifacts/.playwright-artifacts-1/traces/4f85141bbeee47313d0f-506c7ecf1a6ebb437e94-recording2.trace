.app-shell button, .app-shell input, .app-shell select { font: inherit; }\r\n.app-shell :focus-visible { outline: 2px solid #616161; outline-offset: 4px; }\r\n.app-shell__workspace { min-width: 0; }\r\n.app-shell__skip-link { position: absolute; top: 8px; left: 8px; transform: translateY(-200%); z-index: 1; background: #fff; color: #252525; padding: 10px 16px; border: 1px solid #777; border-radius: 8px; }\r\n.app-shell__skip-link:focus { transform: none; }\r\n.app-sidebar { display: flex; flex-direction: column; position: sticky; top: 0; min-width: 0; height: 100dvh; background: #f7f7f7; border-right: 1px solid #dedede; }\r\n.app-sidebar__session { padding: 20px 24px; margin-top: auto; overflow-wrap: anywhere; }\r\n.app-shell--collapsed .app-sidebar__session { padding: 16px 6px; text-align: center; }\r\n.app-shell--collapsed .session-actions button { padding: 6px; font-size: 11px; }\r\n.app-sidebar__controls { display: flex; align-items: center; height: 88px; padding: 0 24px; }\r\n.app-sidebar__toggle { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 4px; border: 1px solid #dcdcdc; border-radius: 8px; background: #fff; color: #646464; cursor: pointer; }\r\n.app-sidebar__toggle:hover { color: #262626; border-color: #b7b7b7; }\r\n.app-sidebar__navigation { display: grid; gap: 8px; padding: 24px 16px; }\r\n.app-sidebar__item { position: relative; isolation: isolate; display: flex; align-items: center; gap: 14px; min-width: 0; min-height: 48px; padding: 12px 16px; border: 1px solid transparent; border-radius: 10px; color: #626262; font-size: 15px; line-height: 22px; text-decoration: none; }\r\na.app-sidebar__item:hover { background: #eee; }\r\n.app-sidebar__item[aria-current] { color: #262626; font-weight: 600; }\r\n.app-sidebar__icon { flex: none; width: 17px; height: 17px; border: 1px solid #b0b0b0; border-radius: 4px; background: #e8e8e8; }\r\n.app-sidebar__item[aria-current] .app-sidebar__icon { background: #575757; border-color: #575757; }\r\n.app-sidebar__item--unavailable { color: #858585; }\r\n.app-sidebar__label { min-width: 0; white-space: nowrap; }\r\n.app-shell--collapsed .app-sidebar__controls { justify-content: center; padding: 0; }\r\n.app-shell--collapsed .app-sidebar__navigation { padding-inline: 10px; }\r\n.app-shell--collapsed .app-sidebar__item { justify-content: center; padding-inline: 0; }\r\n.app-shell--collapsed .app-sidebar__label { display: none; }\r\n.app-shell__header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px 24px; min-height: 88px; padding: 20px 48px; border-bottom: 1px solid #e3e3e3; }\r\n.app-shell__header nav { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; min-width: 0; color: #6b6b6b; font-size: 14px; }\r\n.app-shell__header nav a { color: inherit; text-decoration: none; }\r\n.app-shell__header nav a:hover { color: #252525; text-decoration: underline; }\r\n.app-shell__header nav [aria-current] { color: #343434; }\r\n.app-shell__wordmark { margin-left: auto; font-size: 25px; line-height: 32px; font-weight: 700; letter-spacing: -.6px; white-space: nowrap; }\r\n.app-shell__session { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 12px; margin-left: auto; min-width: 0; max-width: 100%; }\r\n.session-actions { min-width: 0; }\r\n.session-actions button, .store-session-actions button { padding: 7px 12px; border: 1px solid #d3d3d3; border-radius: 8px; background: #fff; color: #444; font: inherit; font-size: 13px; cursor: pointer; }\r\n.session-actions button:disabled { cursor: wait; opacity: .6; }\r\n.session-actions__preview { color: #777; font-size: 11px; }\r\n.session-actions__error { max-width: 340px; font-size: 12px; overflow-wrap: anywhere; }\r\n.store-session-actions { max-width: 680px; padding: 0 20px 32px; margin: 0 auto; }\r\n@media (prefers-reduced-motion: no-preference) and (min-width: 951px) {\r\n  .app-shell { transition: grid-template-columns 200ms cubic-bezier(.22, 1, .36, 1); }\r\n}\r\n@media (max-width: 1180px) {\r\n  .app-shell__header { padding-inline: 28px; }\r\n}\r\n@media (max-width: 950px) {\r\n  .app-shell { grid-template-columns: minmax(0, 1fr); }\r\n  .app-sidebar { position: static; height: auto; border-right: 0; border-bottom: 1px solid #dedede; }\r\n  .app-sidebar__controls { display: none; }\r\n  .app-sidebar__navigation,.app-shell--collapsed .app-sidebar__navigation { display: flex; gap: 4px; padding: 8px 12px; overflow-x: auto; }\r\n  .app-sidebar__item,.app-shell--collapsed .app-sidebar__item { flex: none; gap: 8px; min-height: 40px; padding: 8px 12px; font-size: 13px; }\r\n  .app-shell--collapsed .app-sidebar__label { display: inline; }\r\n  .app-sidebar__icon { width: 13px; height: 13px; }\r\n  .app-sidebar__session,.app-shell--collapsed .app-sidebar__session { padding: 0 16px 8px; text-align: right; }\r\n}\r\n@media (max-width: 680px) {\r\n  .app-shell__header { min-height: 76px; padding: 16px 20px; }\r\n  .app-shell__header nav { font-size: 12px; gap: 8px; }\r\n  .app-shell__wordmark { font-size: 23px; }\r\n}\r\n@media (max-width: 380px) {\r\n  .app-shell__header { padding-inline: 12px; gap: 12px; }\r\n}\r\n"],["STYLE",{},"/* ShelfCash semantic scale, scoped to existing Import surfaces. PL-01 is isolated. */\n:where(.import-page, .import-flow, .import-resolver, .import-evidence, .input-panel) {\n  --sc-import-type-body: 12px;\n  --sc-import-leading-body: 20px;\n  --sc-import-type-control: 12px;\n  --sc-import-leading-control: 20px;\n  --sc-import-type-label: 11px;\n  --sc-import-leading-label: 18px;\n  --sc-import-type-micro: 10px;\n  --sc-import-leading-micro: 16px;\n  --sc-import-type-card: 14px;\n  --sc-import-leading-card: 22px;\n}\n\n/* Values and acknowledgments must not inherit the smaller form-label scale. */\n:is(.import-resolver, .input-source-context) :is(input, select, textarea),\n:is(.import-resolver, .input-source-context) .import-flow__check,\n.input-source-context .import-flow__form .import-flow__check,\n.input-profile-reject .import-flow__check {\n  font-size: var(--sc-import-type-control);\n  line-height: var(--sc-import-leading-control);\n}\n.input-context-evidence .import-flow__spec dt,\n.import-evidence .import-flow__spec dt {\n  font-size: var(--sc-import-type-label);\n  line-height: var(--sc-import-leading-label);\n}\n.input-context-evidence .import-flow__spec dd,\n.import-evidence .import-flow__spec dd {\n  font-size: var(--sc-import-type-body);\n  line-height: var(--sc-import-leading-body);\n}\n.import-flow { min-width: 0; color: #454545; font-size: 14px; line-height: 1.6; }\r\n.import-flow h2 { margin: 0; font-size: 24px; line-height: 1.4; font-weight: 600; letter-spacing: -.4px; }\r\n.import-flow h3 { margin: 0 0 12px; font-size: 16px; font-weight: 600; }\r\n.import-flow p { margin: 8px 0; overflow-wrap: anywhere; }\r\n.import-flow p:empty { display: none; }\r\n.import-flow button, .import-flow select, .import-flow input, .import-flow textarea { font: inherit; }\r\n.import-flow button { min-height: 44px; border: 1px solid #d9d9d9; border-radius: 8px; padding: 9px 14px; background: #fff; color: #454545; cursor: pointer; }\r\n.import-flow button:not(:disabled):hover { border-color: #777; background: #f6f6f6; }\r\n.import-flow button:disabled { color: #888; background: #f3f3f3; cursor: not-allowed; }\r\n.import-flow .import-flow__primary { color: #fff; background: #555; border-color: #555; font-weight: 600; }\r\n.import-flow .import-flow__primary:not(:disabled):hover { background: #404040; }\r\n.import-flow .import-flow__primary:disabled { background: #e9e9e9; color: #777; border-color: #ddd; }\r\n.import-flow__heading, .import-flow__actions, .import-flow__filters, .import-flow__issue-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }\r\n.import-flow__steps { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 20px 0; list-style: none; }\r\n.import-flow__steps button[aria-current=\"step\"] { background: #555; color: #fff; border-color: #555; }\r\n.import-flow__muted { color: #777; font-size: 12px; }\r\n.import-flow__summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin: 18px 0; padding: 18px; border: 1px solid #e2e2e2; border-radius: 12px; background: #fafafa; }\r\n.import-flow__summary div { min-width: 0; }\r\n.import-flow dt { color: #777; font-size: 12px; }\r\n.import-flow dd { margin: 4px 0 0; font-size: 20px; font-weight: 600; overflow-wrap: anywhere; }\r\n.import-flow__layout { display: grid; grid-template-columns: 264px minmax(0, 1fr); gap: 24px; align-items: start; }\r\n.import-flow__navigator { min-width: 0; overflow: hidden; border: 1px solid #dedede; border-radius: 12px; background: #fafafa; }\r\n.import-flow__navigator > header { padding: 18px; border-bottom: 1px solid #e5e5e5; }\r\n.import-flow__navigator > header h3 { margin-bottom: 4px; font-size: 14px; }\r\n.import-flow__navigator > header p { margin: 0; }\r\n.import-flow__navigator > section { padding: 8px 10px; }\r\n.import-flow__navigator > section > p { margin: 8px; font-size: 13px; }\r\n.import-flow__navigator ul { padding: 0; margin: 0; list-style: none; }\r\n.import-flow__navigator li + li { margin-top: 8px; }\r\n.import-flow__navigator button { width: 100%; min-height: 36px; padding: 8px; border-color: transparent; background: transparent; text-align: left; overflow-wrap: anywhere; font-size: 12px; }\r\n.import-flow__navigator button[aria-current=\"true\"] { background: #e9e9e9; border-color: #d9d9d9; color: #303030; font-weight: 600; }\r\n.import-flow__queue { min-width: 0; overflow: hidden; border: 1px solid #dedede; border-radius: 12px; }\r\n.import-flow__filters { justify-content: space-between; margin: 0; padding: 12px 16px; border-bottom: 1px solid #eee; font-size:var(--sc-import-type-body); line-height:var(--sc-import-leading-body);}\r\n.import-flow__filters label { display: flex; align-items: center; gap: 8px; }\r\n.import-flow__filters select { max-width: 100%; min-height: 44px; border: 1px solid #d8d8d8; border-radius: 8px; padding: 8px; background: #fff; color: #454545; }\r\n.import-flow__issue, .import-flow__card { min-width: 0; margin: 0 0 16px; padding: 20px; border: 1px solid #e1e1e1; border-radius: 12px; background: #fff; }\r\n.import-flow__badge { display: inline-block; padding: 3px 9px; border-radius: 5px; background: #f0f0f0; font-size: 12px; overflow-wrap: anywhere; }\r\n.import-flow__samples { color: #777; font-size: 12px; }\r\n.import-flow__selector { display: flex; align-items: end; flex-wrap: wrap; gap: 12px; margin-top: 16px; }\r\n.import-flow__selector label { flex: 1; min-width: 140px; }\r\n.import-flow__selector select, .import-flow textarea { display: block; width: 100%; min-height: 44px; margin-top: 6px; padding: 10px; color: #454545; border: 1px solid #d8d8d8; border-radius: 8px; background: #fff; }\r\n.import-flow textarea { resize: vertical; min-height: 88px; }\r\n.import-flow details { margin-top: 14px; font-size: 12px; }\r\n.import-flow summary { cursor: pointer; min-height: 32px; }\r\n.import-flow pre { max-height: 240px; padding: 12px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; background: #f7f7f7; border-radius: 8px; font-size: 12px; }\r\n.import-flow__footer { position: sticky; bottom: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-top: 24px; padding: 14px 0; border-top: 1px solid #e2e2e2; background: #fff; }\r\n.import-flow__footer p { font-size: 12px; color: #737373; }\r\n.import-flow__footer .import-flow__primary { min-width: 156px; }\r\n.import-flow__notice { padding: 14px 16px; border: 1px solid #b5b5b5; border-radius: 8px; background: #f7f7f7; overflow-wrap: anywhere; }\r\n.import-flow__table-scroll { overflow: auto; max-width: 100%; border: 1px solid #ddd; border-radius: 10px; }\r\n.import-flow table { width: 100%; min-width: 720px; border-collapse: collapse; text-align: left; }\r\n.import-flow caption { text-align: left; padding: 12px; color: #777; font-size: 12px; }\r\n.import-flow th, .import-flow td { max-width: 280px; padding: 12px; border-top: 1px solid #e7e7e7; vertical-align: top; overflow-wrap: anywhere; }\r\n.import-flow th { background: #fafafa; font-size: 12px; font-weight: 600; }\r\n.import-flow td pre { margin: 0; }\r\n.import-flow__check { display: flex; align-items: start; gap: 10px; margin: 16px 0; }\r\n.import-flow input[type=\"checkbox\"] { flex-shrink: 0; width: 18px; height: 18px; margin-top: 3px; accent-color: #555; }\r\n.import-flow__impacts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }\r\n.import-flow a { color: #454545; text-underline-offset: 3px; }\r\n.import-flow__form { min-width: 0; margin: 18px 0 0; padding: 16px; border: 1px solid #e2e2e2; border-radius: 10px; }\r\n.import-flow__form legend { padding: 0 6px; font-weight: 600; }\r\n.import-flow__form > label, .import-flow__form-grid > label { display: block; min-width: 0; margin: 0 0 14px; }\r\n.import-flow__form input:not([type=\"checkbox\"]), .import-flow__form select { display: block; width: 100%; min-height: 44px; margin-top: 6px; padding: 10px; color: #454545; border: 1px solid #d8d8d8; border-radius: 8px; background: #fff; }\r\n.import-flow__form input:disabled, .import-flow__form select:disabled, .import-flow__form textarea:disabled { background: #f3f3f3; color: #777; }\r\n.import-flow__form .import-flow__check { display: flex; }\r\n.import-flow__form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 16px; }\r\n.import-flow__field-info { margin-top: 12px; padding: 12px; border-left: 3px solid #d5d5d5; background: #fafafa; overflow-wrap: anywhere; }\r\n.import-flow__field-info code { font-size: 12px; }\r\n.import-flow__catalogue { max-width: 100%; }\r\n.import-flow__amendments { margin-bottom: 18px; }\r\n.import-flow__amendments h4 { margin: 16px 0 8px; }\r\n.import-flow__profile-comparison { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }\r\n.import-flow__profile-comparison > section { min-width: 0; padding: 14px; border: 1px solid #e7e7e7; border-radius: 8px; background: #fcfcfc; }\r\n.import-flow__profile-comparison h4 { margin: 0 0 14px; }\r\n.import-flow__spec { margin: 0; }\r\n.import-flow__spec > div { padding: 8px 0; border-top: 1px solid #ececec; }\r\n.import-flow__spec dd { margin: 4px 0 0; font-size: 13px; font-weight: 400; }\r\n.import-flow__spec .import-flow__spec { padding-left: 10px; border-left: 2px solid #e7e7e7; }\r\n.import-flow__spec-list { margin: 0; padding-left: 22px; }\r\n.import-flow__spec-list > li + li { margin-top: 8px; }\r\n@media (max-width: 1100px) { .import-flow__layout { grid-template-columns: 200px minmax(0, 1fr); gap: 16px; } }\r\n@media (max-width: 760px) { .import-flow__layout, .import-flow__impacts, .import-flow__profile-comparison { grid-template-columns: minmax(0, 1fr); } .import-flow__navigator ul { display: flex; gap: 8px; flex-wrap: wrap; } .import-flow__navigator li { flex: 1 1 160px; } .import-flow__navigator li + li { margin: 0; } }\r\n@media (max-width: 600px) { .import-flow__issue, .import-flow__card { padding: 14px; } .import-flow__footer { position: static; padding: 14px 0; } .import-flow__footer button, .import-flow__selector button { width: 100%; } .import-flow__selector label { min-width: 0; width: 100%; flex-basis: 100%; } }\r\n@media (max-width: 600px) { .import-flow__form-grid { grid-template-columns: minmax(0, 1fr); } .import-flow__form { padding: 12px; } }\r\n\r\n/* Mapping and receipt composition follow the pinned MagicPath screens. */\r\n.import-flow__navigation { margin: 20px 0 12px !important; color: #777; }\r\n.import-flow__navigation > summary { min-height: 24px; width: fit-content; }\r\n.import-flow__profile-review { padding: 16px 20px; border: 1px solid #dedede; border-radius: 12px; }\r\n.import-flow__profile-review > summary { font-size: 14px; font-weight: 600; }\r\n.import-mapping-progress { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; margin-bottom: 20px; padding: 20px 24px; border: 1px solid #dedede; border-radius: 12px; background: #fafafa; }\r\n.import-mapping-progress dl { display: flex; flex-wrap: wrap; gap: 28px; margin: 0; }\r\n.import-mapping-progress dl > div { display: flex; flex-direction: column-reverse; gap: 2px; }\r\n.import-mapping-progress dd { margin: 0; color: #454545; font-size: 24px; line-height: 32px; }\r\n.import-mapping-progress__track { width: 234px; max-width: 100%; color: #7a7a7a; font-size: 12px; }\r\n.import-mapping-progress__track strong { color: #484848; }\r\n.import-mapping-progress__bar { height: 6px; margin-top: 10px; border-radius: 4px; overflow: hidden; background: #e5e5e5; }\r\n.import-mapping-progress__bar > span { display: block; height: 100%; border-radius: inherit; background: #575757; transform-origin: left; }\r\n.import-mapping-sheet-header { padding: 14px 20px; border-bottom: 1px solid #e9e9e9; }\r\n.import-mapping-sheet-header p { margin: 0 0 3px; }\r\n.import-mapping-sheet-header h3 { margin: 0; font-size: 18px; line-height: 26px; }\r\n.import-mapping-sheet-header details { margin-top: 8px; }\r\n.import-mapping-filter-tabs { display: flex; flex-wrap: wrap; gap: 4px; }\r\n.import-mapping-filter-tabs button { position: relative; isolation: isolate; min-height: 30px; padding: 5px 8px; border-color: transparent; border-radius: 6px; font-size:var(--sc-import-type-control); color: #737373; line-height:var(--sc-import-leading-control);}\r\n.import-mapping-filter-tabs button[aria-pressed=\"true\"] { color: #424242; }\r\n.import-mapping-card-list { padding: 16px; max-height: 560px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }\r\n.import-mapping-card-list .import-flow__issue { padding: 16px; border-radius: 9px; margin-bottom: 12px; }\