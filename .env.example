# Public browser configuration only. Never put API keys or secrets in VITE_*.
# mock is local dev-server preview only; deploy/build with api.
VITE_DATA_SOURCE=mock
# Origin (or reverse-proxy base path); feature paths include /api/v1.
VITE_API_BASE_URL=http://localhost:18001
# Cookie-based API integration requires HTTPS or an explicitly configured BE loopback cookie.
# Store scope comes from A03 + T02, never a VITE_* Store override.
