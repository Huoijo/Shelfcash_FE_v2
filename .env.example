# Public browser configuration only. Never put API keys or secrets in VITE_*.
VITE_DATA_SOURCE=mock
# Origin (or reverse-proxy base path); feature paths include /api/v1.
VITE_API_BASE_URL=http://localhost:8000
# API development only: an actual Store UUID, until session/Store integration exists.
# This selects request scope; it does not grant access. Leave empty in mock mode.
VITE_DEV_STORE_ID=
