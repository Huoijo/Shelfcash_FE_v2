{
  "$defs": {
    "ErrorDetails": {
      "additionalProperties": false,
      "properties": {
        "approval_request_allowed": {
          "const": false,
          "default": false,
          "title": "Approval Request Allowed",
          "type": "boolean"
        }
      },
      "title": "ErrorDetails",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/ErrorDetails"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pagination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "total_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Count"
        }
      },
      "required": [
        "limit",
        "next_cursor",
        "total_count"
      ],
      "title": "Pagination",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "title": "Data",
      "type": "null"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "error": {
      "$ref": "#/$defs/ErrorInfo"
    }
  },
  "required": [
    "data",
    "meta",
    "error"
  ],
  "title": "ErrorEnvelope",
  "type": "object"
}
