{
  "$defs": {
    "ImportHistory": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ImportHistoryItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ImportHistory",
      "type": "object"
    },
    "ImportHistoryItem": {
      "additionalProperties": false,
      "properties": {
        "import_id": {
          "format": "uuid",
          "title": "Import Id",
          "type": "string"
        },
        "display_number": {
          "title": "Display Number",
          "type": "string"
        },
        "data_date": {
          "format": "date",
          "title": "Data Date",
          "type": "string"
        },
        "imported_at": {
          "format": "date-time",
          "title": "Imported At",
          "type": "string"
        },
        "file_count": {
          "title": "File Count",
          "type": "integer"
        },
        "status": {
          "enum": [
            "in_progress",
            "completed",
            "completed_with_warnings",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "import_id",
        "display_number",
        "data_date",
        "imported_at",
        "file_count",
        "status"
      ],
      "title": "ImportHistoryItem",
      "type": "object"
    },
    "ImportHistoryMeta": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Warnings",
          "type": "array"
        },
        "pagination": {
          "$ref": "#/$defs/Pagination"
        },
        "unfiltered_date_count": {
          "title": "Unfiltered Date Count",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "pagination",
        "unfiltered_date_count"
      ],
      "title": "ImportHistoryMeta",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "WARNING",
            "ERROR"
          ],
          "title": "Severity",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "impact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impact"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Notice",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "total_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Count"
        }
      },
      "required": [
        "limit",
        "next_cursor",
        "total_count"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "sheet_id": {
          "format": "uuid",
          "title": "Sheet Id",
          "type": "string"
        },
        "row_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Number"
        },
        "source_column_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Column Index"
        },
        "record_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Number"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        }
      },
      "required": [
        "file_id",
        "sheet_id"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/ImportHistory"
    },
    "meta": {
      "$ref": "#/$defs/ImportHistoryMeta"
    },
    "error": {
      "title": "Error",
      "type": "null"
    }
  },
  "required": [
    "data",
    "meta",
    "error"
  ],
  "title": "HistoryEnvelope[ImportHistory, ImportHistoryMeta]",
  "type": "object"
}
