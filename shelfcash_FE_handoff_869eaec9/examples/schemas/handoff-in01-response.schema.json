{
  "$defs": {
    "DeclineReceipt": {
      "additionalProperties": false,
      "properties": {
        "invitation_id": {
          "format": "uuid",
          "title": "Invitation Id",
          "type": "string"
        },
        "store_id": {
          "format": "uuid",
          "title": "Store Id",
          "type": "string"
        },
        "status": {
          "const": "declined",
          "default": "declined",
          "title": "Status",
          "type": "string"
        },
        "declined_at": {
          "format": "date-time",
          "title": "Declined At",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "next_action": {
          "const": "return_to_stores",
          "default": "return_to_stores",
          "title": "Next Action",
          "type": "string"
        }
      },
      "required": [
        "invitation_id",
        "store_id",
        "declined_at",
        "version",
        "event_id"
      ],
      "title": "DeclineReceipt",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pagination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "total_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Count"
        }
      },
      "required": [
        "limit",
        "next_cursor",
        "total_count"
      ],
      "title": "Pagination",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/DeclineReceipt"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "error": {
      "title": "Error",
      "type": "null"
    }
  },
  "required": [
    "data",
    "meta",
    "error"
  ],
  "title": "Envelope[DeclineReceipt]",
  "type": "object"
}
