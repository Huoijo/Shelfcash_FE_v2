{
  "$defs": {
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pagination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "total_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Count"
        }
      },
      "required": [
        "limit",
        "next_cursor",
        "total_count"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "ReadState": {
      "additionalProperties": false,
      "properties": {
        "notification_id": {
          "format": "uuid",
          "title": "Notification Id",
          "type": "string"
        },
        "read_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Read At"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "notification_id",
        "read_at",
        "version"
      ],
      "title": "ReadState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/ReadState"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "error": {
      "title": "Error",
      "type": "null"
    }
  },
  "required": [
    "data",
    "meta",
    "error"
  ],
  "title": "Envelope[ReadState]",
  "type": "object"
}
