{
  "$defs": {
    "AnalysisResult": {
      "additionalProperties": false,
      "properties": {
        "resource_type": {
          "const": "import_analysis",
          "title": "Resource Type",
          "type": "string"
        },
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "analysis_id": {
          "format": "uuid",
          "title": "Analysis Id",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "resource_id",
        "analysis_id"
      ],
      "title": "AnalysisResult",
      "type": "object"
    },
    "CompletionResult": {
      "additionalProperties": false,
      "properties": {
        "resource_type": {
          "const": "import_completion",
          "default": "import_completion",
          "title": "Resource Type",
          "type": "string"
        },
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "commit_id": {
          "format": "uuid",
          "title": "Commit Id",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "commit_id"
      ],
      "title": "CompletionResult",
      "type": "object"
    },
    "ExportJobContext": {
      "additionalProperties": false,
      "properties": {
        "store_id": {
          "format": "uuid",
          "title": "Store Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "export_id": {
          "format": "uuid",
          "title": "Export Id",
          "type": "string"
        }
      },
      "required": [
        "store_id",
        "run_id",
        "export_id"
      ],
      "title": "ExportJobContext",
      "type": "object"
    },
    "ExportJobResult": {
      "additionalProperties": false,
      "properties": {
        "resource_type": {
          "const": "planning_pdf_export",
          "default": "planning_pdf_export",
          "title": "Resource Type",
          "type": "string"
        },
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "option_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "download_url": {
          "title": "Download Url",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_count": {
          "exclusiveMinimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "media_type": {
          "const": "application/pdf",
          "default": "application/pdf",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "resource_id",
        "run_id",
        "option_id",
        "download_url",
        "sha256",
        "byte_count"
      ],
      "title": "ExportJobResult",
      "type": "object"
    },
    "ImportMeta": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "warnings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Warnings",
          "type": "array"
        },
        "poll_after_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Poll After Ms"
        },
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pagination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id"
      ],
      "title": "ImportMeta",
      "type": "object"
    },
    "JobContext": {
      "additionalProperties": false,
      "properties": {
        "store_id": {
          "format": "uuid",
          "title": "Store Id",
          "type": "string"
        },
        "import_id": {
          "format": "uuid",
          "title": "Import Id",
          "type": "string"
        }
      },
      "required": [
        "store_id",
        "import_id"
      ],
      "title": "JobContext",
      "type": "object"
    },
    "JobError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/JobErrorDetails"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "JobError",
      "type": "object"
    },
    "JobErrorDetails": {
      "additionalProperties": false,
      "properties": {
        "source_locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ParseFailureLocation"
          },
          "title": "Source Locations",
          "type": "array"
        },
        "blockers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Notice"
          },
          "title": "Blockers",
          "type": "array"
        },
        "approval_request_allowed": {
          "const": false,
          "default": false,
          "title": "Approval Request Allowed",
          "type": "boolean"
        }
      },
      "title": "JobErrorDetails",
      "type": "object"
    },
    "JobView": {
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "format": "uuid",
          "title": "Job Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "import_analyze",
            "import_preview",
            "import_commit",
            "planning_pdf_export"
          ],
          "title": "Operation",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "stage": {
          "enum": [
            "queued",
            "parsing",
            "mapping",
            "validating",
            "committing",
            "rendering",
            "completed",
            "failed"
          ],
          "title": "Stage",
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Progress"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Completed At"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobContext"
            },
            {
              "$ref": "#/$defs/ExportJobContext"
            }
          ],
          "title": "Context"
        },
        "result": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "import_analysis": "#/$defs/AnalysisResult",
                  "import_completion": "#/$defs/CompletionResult",
                  "import_preview": "#/$defs/PreviewResult",
                  "planning_pdf_export": "#/$defs/ExportJobResult"
                },
                "propertyName": "resource_type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/AnalysisResult"
                },
                {
                  "$ref": "#/$defs/PreviewResult"
                },
                {
                  "$ref": "#/$defs/CompletionResult"
                },
                {
                  "$ref": "#/$defs/ExportJobResult"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "title": "Result"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_id",
        "operation",
        "status",
        "stage",
        "progress",
        "created_at",
        "started_at",
        "completed_at",
        "context",
        "result",
        "error"
      ],
      "title": "JobView",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "WARNING",
            "ERROR"
          ],
          "title": "Severity",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "impact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impact"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Notice",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "total_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Total Count"
        }
      },
      "required": [
        "limit",
        "next_cursor",
        "total_count"
      ],
      "title": "Pagination",
      "type": "object"
    },
    "ParseFailureLocation": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "sheet_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Name"
        },
        "row_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Number"
        },
        "source_column_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Column Index"
        }
      },
      "required": [
        "file_id"
      ],
      "title": "ParseFailureLocation",
      "type": "object"
    },
    "PreviewResult": {
      "additionalProperties": false,
      "properties": {
        "resource_type": {
          "const": "import_preview",
          "title": "Resource Type",
          "type": "string"
        },
        "resource_id": {
          "format": "uuid",
          "title": "Resource Id",
          "type": "string"
        },
        "preview_id": {
          "format": "uuid",
          "title": "Preview Id",
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "resource_id",
        "preview_id"
      ],
      "title": "PreviewResult",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "sheet_id": {
          "format": "uuid",
          "title": "Sheet Id",
          "type": "string"
        },
        "row_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Number"
        },
        "source_column_index": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Column Index"
        },
        "record_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Number"
        },
        "line_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Start"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        }
      },
      "required": [
        "file_id",
        "sheet_id"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/JobView"
    },
    "meta": {
      "$ref": "#/$defs/ImportMeta"
    },
    "error": {
      "title": "Error",
      "type": "null"
    }
  },
  "required": [
    "data",
    "meta",
    "error"
  ],
  "title": "ImportEnvelope[JobView]",
  "type": "object"
}
