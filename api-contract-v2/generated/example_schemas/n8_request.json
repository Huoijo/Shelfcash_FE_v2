          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Minimum Usable Quantity"
    },
    "unit": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Unit",
      "type": "string"
    },
    "reason": {
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "minimum_usable_quantity",
    "unit",
    "reason"
  ],
  "title": "ThresholdRequest",
  "type": "object"
}
