    "OperationalBasis": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "operational_basis/1",
          "title": "Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "CURRENT_CAPTURE",
            "HYPOTHETICAL_CURRENT_CAPTURE"
