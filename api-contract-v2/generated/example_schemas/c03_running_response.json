{
  "$defs": {
    "Assessment": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "format": "uuid",
          "title": "Product Id",
          "type": "string"
        },
        "path": {
          "enum": [
            "LOW",
            "BASE",
            "HIGH"
          ],
          "title": "Path",
          "type": "string"
        },
        "target_percent": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Target Percent",
          "type": "string"
        },
        "applied_source": {
          "enum": [
            "common",
            "product_override"
          ],
          "title": "Applied Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_EVALUATED"
          ],
          "title": "Status",
          "type": "string"
        },
        "shortfall": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactQuantity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "product_id",
        "path",
        "target_percent",
        "applied_source",
        "status",
        "shortfall"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "BudgetAtAcceptance": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Limit",
          "type": "string"
        },
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "ceiling_at_acceptance": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Ceiling At Acceptance",
          "type": "string"
        },
        "ceiling_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Ceiling Version",
          "type": "string"
        }
      },
      "required": [
        "limit",
        "currency",
        "ceiling_at_acceptance",
        "ceiling_version"
      ],
      "title": "BudgetAtAcceptance",
      "type": "object"
    },
    "Costs": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "title": "Currency",
          "type": "string"
        },
        "purchase": {
          "$ref": "#/$defs/ExactQuantity"
        },
        "payable_fees": {
          "$ref": "#/$defs/ExactQuantity"
        },
        "delivery_fees": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExactQuantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "fee_classification": {
          "enum": [
            "DECLARED_DELIVERY",
            "PAYABLE_FEE_TYPE_NOT_CAPTURED",
            "NONE"
          ],
          "title": "Fee Classification",
          "type": "string"
        },
        "total": {
          "$ref": "#/$defs/ExactQuantity"
        },
        "fee_components": {
          "items": {
            "$ref": "#/$defs/PlanningFeeComponent"
          },
          "title": "Fee Components",
          "type": "array"
        }
      },
      "required": [
        "currency",
        "purchase",
        "payable_fees",
        "delivery_fees",
        "fee_classification",
        "total",
        "fee_components"
      ],
      "title": "Costs",
      "type": "object"
    },
    "CustomPath": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "LOW",
            "BASE",
            "HIGH"
          ],
          "title": "Path",
          "type": "string"
        },
        "min_fill_rate_percent": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Fill Rate Percent"
        },
        "product_overrides": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ProductOverride"
              },
              "maxItems": 50,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Overrides"
        }
      },
      "required": [
        "path"
      ],
      "title": "CustomPath",
      "type": "object"
    },
    "CustomRequirements": {
      "additionalProperties": false,
      "properties": {
        "paths": {
          "items": {
            "$ref": "#/$defs/CustomPath"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "budget_limit": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Limit"
        }
      },
      "required": [
        "paths"
      ],
      "title": "CustomRequirements",
      "type": "object"
    },
    "ExactQuantity": {
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "maxLength": 1000,
          "pattern": "^(0|[1-9][0-9]*)$",
          "title": "Numerator",
          "type": "string"
        },
        "denominator": {
          "maxLength": 1000,
          "pattern": "^[1-9][0-9]*$",
          "title": "Denominator",
          "type": "string"
        },
        "decimal_view": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Decimal View",
          "type": "string"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "decimal_view"
      ],
      "title": "ExactQuantity",
      "type": "object"
    },
    "ExcludedOverride": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "enum": [
            "LOW",
            "BASE",
            "HIGH"
          ],
          "title": "Path",
          "type": "string"
        },
        "target_percent": {
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Target Percent",
          "type": "string"
        },
        "status": {
          "const": "NOT_EVALUATED",
          "default": "NOT_EVALUATED",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "path",
        "target_percent"
      ],
      "title": "ExcludedOverride",
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "format": "uuid",
          "title": "Product Id",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "affected_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Affected Dates",
          "type": "array"
        },
        "ingredient_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Ingredient Ids",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "suggested_action": {
          "title": "Suggested Action",
          "type": "string"
        },
        "requirement_overrides": {
          "items": {
            "$ref": "#/$defs/ExcludedOverride"
          },
          "title": "Requirement Overrides",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "code",
        "field",
        "affected_dates",
        "ingredient_ids",
        "message",
        "suggested_action",
        "requirement_overrides"
      ],
      "title": "Exclusion",
      "type": "object"
    },
