        "version",
        "kind",
        "captured_at",
        "timezone",
        "local_capture_date",
        "planning_start_date",
        "assumptions"
      ],
      "title": "OperationalBasis",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "option_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Option Id",
          "type": "string"
        },
        "source_strategies": {
          "items": {
            "enum": [
              "lean",
              "balanced",
              "protected"
            ],
            "type": "string"
          },
          "title": "Source Strategies",
          "type": "array"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "rejection_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Rejection Reasons",
          "type": "array"
        },
        "not_selected_reason": {
          "anyOf": [
            {
              "enum": [
                "HIGHER_COST",
                "LOWER_SERVICE_TIE",
                "STABLE_ORDER_TIE",
                "CUSTOMER_REQUIREMENTS_NOT_MET",
                "RELATED_BLOCKER"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Not Selected Reason"
        },
        "costs": {
          "$ref": "#/$defs/Costs"
        },
        "purchases": {
          "items": {
            "$ref": "#/$defs/Purchase"
          },
          "title": "Purchases",
          "type": "array"
        },
        "product_services": {
          "items": {
            "$ref": "#/$defs/ProductService"
          },
          "title": "Product Services",
          "type": "array"
        },
        "ingredient_balances": {
          "items": {
            "$ref": "#/$defs/IngredientBalance"
          },
          "title": "Ingredient Balances",
          "type": "array"
        },
        "requirements_assessment": {
          "items": {
            "$ref": "#/$defs/Assessment"
          },
          "title": "Requirements Assessment",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/PlanningNotification"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "option_id",
        "source_strategies",
        "eligible",
        "rejection_reasons",
        "not_selected_reason",
        "costs",
        "purchases",
        "product_services",
        "ingredient_balances",
        "requirements_assessment",
        "issues"
      ],
      "title": "Option",
      "type": "object"
