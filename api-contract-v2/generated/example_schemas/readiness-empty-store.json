          "title": "Actions",
          "type": "array"
        },
        "source_versions": {
          "$ref": "#/$defs/SourceVersions"
        },
        "scope_estimate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScopeEstimate"
            },
            {
              "type": "null"
            }
          ]
        },
        "history_watermark": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "History Watermark"
        }
      },
      "required": [
        "store_id",
        "as_of_date",
        "evaluated_at",
        "data_version",
        "evaluated_forecast_start_date",
        "cutoff_date",
        "actions",
        "source_versions",
        "scope_estimate",
        "history_watermark"
      ],
      "title": "Readiness",
      "type": "object"
    },
    "ScopeEstimate": {
