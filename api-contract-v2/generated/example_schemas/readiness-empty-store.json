{
  "$defs": {
    "ActionReadiness": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "import",
            "menu",
            "inventory",
            "forecast",
            "planning"
          ],
          "title": "Action",
          "type": "string"
        },
        "availability": {
          "enum": [
            "ready",
            "blocked",
            "unknown"
          ],
          "title": "Availability",
          "type": "string"
        },
        "can_execute": {
          "title": "Can Execute",
          "type": "boolean"
        },
        "data_status": {
          "enum": [
            "valid",
            "invalid",
            "incomplete",
            "unknown"
          ],
          "title": "Data Status",
          "type": "string"
        },
        "execution_status": {
          "enum": [
            "available",
            "unavailable",
            "unknown"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "blockers": {
          "items": {
            "$ref": "#/$defs/CompletionReadinessIssue"
          },
          "title": "Blockers",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/CompletionReadinessIssue"
          },
          "title": "Warnings",
          "type": "array"
        },
        "result_assessment": {
          "const": "NOT_ASSESSED",
          "default": "NOT_ASSESSED",
          "title": "Result Assessment",
          "type": "string"
        }
      },
      "required": [
        "action",
        "availability",
        "can_execute",
        "data_status",
        "execution_status",
        "blockers",
        "warnings"
      ],
      "title": "ActionReadiness",
      "type": "object"
    },
    "CompletionReadinessDetails": {
      "additionalProperties": false,
      "properties": {},
      "title": "CompletionReadinessDetails",
      "type": "object"
    },
    "CompletionReadinessIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "source": {
          "enum": [
            "authorization",
            "catalog",
            "recipe",
            "sales",
            "inventory",
            "supplier",
            "fees",
            "constraints",
            "forecast",
            "configuration",
            "runtime"
          ],
          "title": "Source",
          "type": "string"
        },
        "scope": {
          "enum": [
            "STORE",
            "PRODUCT",
            "INGREDIENT"
          ],
          "title": "Scope",
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Id"
        },
        "affected_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Affected Dates",
          "type": "array"
        },
        "details": {
          "$ref": "#/$defs/CompletionReadinessDetails"
        }
      },
      "required": [
        "code",
        "source",
        "scope",
        "entity_id",
        "affected_dates",
        "details"
      ],
      "title": "CompletionReadinessIssue",
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "properties": {
        "product_id": {
          "format": "uuid",
          "title": "Product Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "affected_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Affected Dates",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "reason_codes",
        "affected_dates"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "pagination": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pagination"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Pagination": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "total_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
