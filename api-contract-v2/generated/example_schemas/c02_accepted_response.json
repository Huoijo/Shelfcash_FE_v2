{
  "$defs": {
    "Accepted": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "accepted_at": {
          "format": "date-time",
          "title": "Accepted At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "status",
        "accepted_at"
      ],
      "title": "Accepted",
      "type": "object"
    },
    "PlanningNotification": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/PlanningNotificationDetails"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "PlanningNotification",
      "type": "object"
    },
    "PlanningNotificationDetails": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "entity_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "affected_dates": {
          "anyOf": [
            {
              "items": {
                "format": "date",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Dates"
        },
        "ingredient_ids": {
          "anyOf": [
            {
              "items": {
                "format": "uuid",
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingredient Ids"
        },
        "default_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Updated At"
        },
        "saved_updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saved Updated At"
        },
        "classification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classification"
        },
        "proof_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proof Scope"
        },
        "suggested_action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggested Action"
        }
      },
      "title": "PlanningNotificationDetails",
      "type": "object"
    },
    "PollMeta": {
      "additionalProperties": false,
      "properties": {
        "warnings": {
          "items": {
            "$ref": "#/$defs/PlanningNotification"
          },
          "title": "Warnings",
          "type": "array"
        },
        "poll_after_ms": {
          "enum": [
            0,
            2000
          ],
          "title": "Poll After Ms",
          "type": "integer"
        }
      },
      "required": [
        "warnings",
        "poll_after_ms"
      ],
      "title": "PollMeta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/Accepted"
    },
    "meta": {
      "$ref": "#/$defs/PollMeta"
    },
    "error": {
      "title": "Error",
      "type": "null"
    }
  },
  "required": [
    "data",
    "meta",
    "error"
  ],
  "title": "PlanningEnvelope[Accepted]",
  "type": "object"
}
